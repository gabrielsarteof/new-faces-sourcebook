---
/**
 * Trilho "Nesta página".
 *
 * Usa o mesmo par de idiomas do painel lateral do criador: rótulo de grupo em
 * app-section-label e item em app-nav-item, com o corrente marcado por
 * aria-current, que é o que o item lê para pintar o estado ativo.
 *
 * Lista só heading Markdown real. Documento sem heading não recebe trilho: os 28
 * do corpus que marcam seção em caixa alta caem nesse caso de propósito, porque o
 * site não infere estrutura que o manual não publicou.
 */
interface Heading { depth: number; slug: string; text: string }
interface Props { headings?: Heading[] }

const { headings = [] } = Astro.props;
const itens = headings.filter(h => h.depth === 2 || h.depth === 3);
---
{itens.length > 0 && (
  <aside class="hidden w-56 shrink-0 xl:block" aria-label="Nesta página">
    <div class="sidebar-scroll sticky top-6 max-h-[calc(100vh-6rem)] overflow-y-auto">
      <p class="app-section-label">Nesta página</p>
      <nav class="flex flex-col">
        {itens.map(h => (
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class:list={['app-nav-item no-underline !text-[13px]', h.depth === 3 ? '!pl-5' : '']}
          >{h.text}</a>
        ))}
      </nav>
    </div>
  </aside>
)}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  if (links.length > 0) {
    const alvos = links
      .map(l => document.getElementById(l.dataset.tocLink!))
      .filter((e): e is HTMLElement => e !== null);

    const ativo = (slug: string | null) => {
      for (const l of links) {
        if (l.dataset.tocLink === slug) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
      }
    };

    // O scroll acontece no wrapper interno, como no criador, não na janela.
    const scroller = document.querySelector('.page-scroll') ?? window;

    const marcar = () => {
      const linha = 120;
      let atual: string | null = null;
      for (const el of alvos) {
        if (el.getBoundingClientRect().top <= linha) atual = el.id;
        else break;
      }
      ativo(atual ?? alvos[0]?.id ?? null);
    };

    marcar();
    let agendado = false;
    scroller.addEventListener('scroll', () => {
      if (agendado) return;
      agendado = true;
      requestAnimationFrame(() => { marcar(); agendado = false; });
    }, { passive: true });
  }
</script>
