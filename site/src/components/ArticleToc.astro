---
/**
 * Trilho "Nesta página".
 *
 * O criador tem o análogo em SheetTableOfContents.tsx, com o mesmo rótulo em
 * uppercase e o mesmo destaque de item ativo por card. Aqui o item é textual,
 * porque heading de documento não tem ícone, mas o ativo usa toc-card-active,
 * que é a sombra que o criador aplica ao item corrente.
 *
 * Lista só heading Markdown real. Documento sem heading não recebe trilho: os 28
 * do corpus que marcam seção em caixa alta caem nesse caso de propósito, porque o
 * site não infere estrutura que o manual não publicou.
 */
interface Heading { depth: number; slug: string; text: string }
interface Props { headings?: Heading[] }

const { headings = [] } = Astro.props;
const itens = headings.filter(h => h.depth === 2 || h.depth === 3);
---
{itens.length > 0 && (
  <aside class="hidden w-60 shrink-0 xl:block" aria-label="Nesta página">
    <div class="sidebar-scroll sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto py-6 pr-3">
      <h2 class="app-nav-label mb-2 px-3 text-mono-muted">Nesta página</h2>
      <div class="flex flex-col gap-0.5">
        {itens.map(h => (
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class:list={[
              'app-nav-row no-underline text-[12.5px] leading-snug !min-h-9',
              h.depth === 3 ? '!pl-6' : '',
            ]}
          >{h.text}</a>
        ))}
      </div>
    </div>
  </aside>
)}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  if (links.length > 0) {
    const alvos = links
      .map(l => document.getElementById(l.dataset.tocLink!))
      .filter((e): e is HTMLElement => e !== null);

    const ativo = (slug: string | null) => {
      for (const l of links) {
        const on = l.dataset.tocLink === slug;
        l.classList.toggle('toc-card-active', on);
        // aria-current é o que o app-nav-row lê para pintar o estado ativo
        if (on) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
      }
    };

    const marcar = () => {
      const linha = 96;
      let atual: string | null = null;
      for (const el of alvos) {
        if (el.getBoundingClientRect().top <= linha) atual = el.id;
        else break;
      }
      ativo(atual ?? alvos[0]?.id ?? null);
    };

    marcar();
    let agendado = false;
    addEventListener('scroll', () => {
      if (agendado) return;
      agendado = true;
      requestAnimationFrame(() => { marcar(); agendado = false; });
    }, { passive: true });
  }
</script>
