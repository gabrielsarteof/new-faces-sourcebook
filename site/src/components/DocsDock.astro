---
import ThemeToggle from './ThemeToggle.astro';
import { arvoreDeNavegacao, mundoDaRota } from '../application/navegacao';
import { iconeDoMundo } from '../data/rotulos';

/**
 * Dock de ícones, 72px em repouso.
 *
 * Seleciona a seção; o painel ao lado (ou a própria página, em Início e Começar)
 * mostra o conteúdo dela. Os mundos saem da árvore derivada da coleção, não de uma
 * lista escrita à mão.
 *
 * `common` não aparece aqui de propósito: as sete perícias sem cenário são jogáveis
 * e o Índice de Perícias já as lista junto das de Naruto, então elas vivem dentro do
 * eixo de perícias de cada mundo jogável em vez de fingir ser um mundo.
 *
 * No hover ou no foco por teclado, o próprio dock cresce e revela o rótulo ao lado
 * de cada ícone. Ele cresce por cima do conteúdo, sem empurrá-lo: hover é pré-via,
 * não é compromisso, e o padrão de mercado (Vercel, Linear, o rail de ícones do VS
 * Code) trata os dois gestos como coisas diferentes — clique reflui o layout,
 * hover não. Reflodir o layout a cada passada de mouse perto da borda esquerda
 * seria pior ainda aqui, porque o painel de documentos já reflui no clique: dois
 * refluxos concorrentes (um por hover, outro por navegação) brigariam entre si.
 *
 * O logo acompanha o mesmo gesto: o ícone quadrado dá lugar ao wordmark completo,
 * os dois ancorados na mesma borda esquerda que os ícones dos itens abaixo — nunca
 * centralizados, porque um logo centralizado numa barra que muda de largura desliza
 * de lugar a cada hover, e nada deve se mover além da largura do próprio dock.
 */
interface Props { rotaAtual?: string }
const { rotaAtual = '/' } = Astro.props;

const arvore = await arvoreDeNavegacao();
const mundoAtual = mundoDaRota(rotaAtual, arvore);
const naInicio = rotaAtual === '/';
const emComecar = rotaAtual === '/comecar';
const CRIADOR = 'https://new-faces-character-creator.vercel.app';
---
<nav
  class="dock-expandivel fixed inset-y-0 left-0 z-[80] hidden flex-col overflow-hidden navbar-bg sidebar-boundary px-1.5 py-3 lg:flex"
  aria-label="Navegação principal"
>
  {/*
    Reaproveita .app-dock-btn e .app-icon-card em vez de recalcular o recuo à mão:
    o cartão de ícone centraliza um SVG de 22px numa caixa de 36px, e sem essa
    mesma caixa em volta do logo os dois ficariam desalinhados por 7px.
  */}
  {/*
    Expandido, o logo vira exatamente o cabeçalho do painel de documentos:
    logo-wordmark.png + "docs" em app-section-label, lado a lado. Não é a mesma
    imagem só maior — é a mesma composição, reaproveitada e não reinventada. O
    ícone quadrado ocupa o cartão fixo à esquerda e desaparece no hover; o
    wordmark+docs mora no mesmo slot de revelação que todo rótulo do dock usa,
    então ganha a largura e a opacidade de graça, sem CSS próprio.
  */}
  <a href="/" aria-label="Início" class="app-dock-btn mb-2 no-underline">
    <span class="app-icon-card">
      <img
        src="/logo-icon.png" alt="" width="24" height="24" draggable="false"
        class="app-dock-logo-icon h-6 w-6 select-none object-contain"
      />
    </span>
    <span class="app-dock-label flex items-center gap-1.5" aria-hidden="true">
      <img
        src="/logo-wordmark.png" alt="" draggable="false"
        class="h-8 w-auto shrink-0 select-none object-contain"
      />
      <span class="app-section-label !p-0 !text-[10px]">docs</span>
    </span>
  </a>

  <div class="flex shrink-0 flex-col">
    <a href="/" class="app-dock-btn no-underline" aria-current={naInicio ? 'page' : undefined}>
      <span class="app-icon-card">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={naInicio ? 2.2 : 1.5} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M9 22V12h6v10" />
        </svg>
      </span>
      <span class="app-dock-label">Início</span>
    </a>

    <a href="/comecar" class="app-dock-btn no-underline" aria-current={emComecar ? 'page' : undefined}>
      <span class="app-icon-card">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={emComecar ? 2.2 : 1.5} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 22V4" /><path d="M4 15c2-1 4-1 6 0s4 1 6 0V4c-2 1-4 1-6 0S6 3 4 4Z" />
        </svg>
      </span>
      <span class="app-dock-label">Começar</span>
    </a>

    <div class="my-1.5 h-px shrink-0 bg-mono-border" role="separator" />

    {arvore.map(m => {
      const ativo = mundoAtual?.base === m.base;
      return (
        <a href={m.base} class="app-dock-btn no-underline" aria-current={ativo ? 'page' : undefined}>
          <span class="app-icon-card">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={ativo ? 2.2 : 1.5} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {iconeDoMundo(m.base.slice(1)).map(d => <path d={d} />)}
            </svg>
          </span>
          <span class="app-dock-label">{m.rotulo}</span>
        </a>
      );
    })}
  </div>

  <div class="mt-auto flex flex-col items-stretch gap-1">
    <a href={CRIADOR} class="app-dock-btn no-underline">
      <span class="app-icon-card">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 3.5a2.1 2.1 0 0 1 3 3L8 17.5l-4 1 1-4Z" />
        </svg>
      </span>
      <span class="app-dock-label">Criador de fichas</span>
    </a>
    <ThemeToggle />
  </div>
</nav>
