---
import ThemeToggle from './ThemeToggle.astro';
import { MUNDOS, mundoDaRota } from '../data/navegacao';

/**
 * Dock de ícones, 72px.
 *
 * Seleciona o mundo; o painel ao lado lista os documentos dele. É a mesma divisão
 * de trabalho que SystemSidebar e QuickSwitchPanel têm no criador, e ela importa
 * aqui porque Naruto sozinho responde por cerca de 150 dos 183 documentos: uma
 * árvore única com tudo não se percorre.
 *
 * Sem texto, como o dock do criador. O rótulo vive no title e no aria-label.
 */
interface Props { rotaAtual?: string }
const { rotaAtual = '/' } = Astro.props;
const atual = mundoDaRota(rotaAtual);
const CRIADOR = 'https://new-faces-character-creator.vercel.app';
---
<nav
  class="fixed inset-y-0 left-0 z-[80] hidden w-18 flex-col navbar-bg sidebar-boundary px-1.5 pt-14 pb-3 lg:flex"
  aria-label="Mundos"
>
  <div class="absolute inset-x-0 top-0 flex h-14 items-center justify-center">
    <a href="/" class="flex h-9 w-9 items-center justify-center" aria-label="Início">
      <img src="/logo-icon.png" alt="" width="24" height="24" class="h-6 w-6 select-none object-contain" draggable="false" />
    </a>
  </div>

  <div class="flex shrink-0 flex-col">
    {MUNDOS.map(m => {
      const ativo = m.base === atual.base;
      return (
        <a
          href={m.base}
          class="app-dock-btn no-underline"
          aria-current={ativo ? 'page' : undefined}
          aria-label={m.rotulo}
          title={m.rotulo}
        >
          <span class="app-icon-card">
            <svg
              width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width={ativo ? 2.2 : 1.5} stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"
            >
              {m.icone.split(' M').map((d, i) => <path d={i === 0 ? d : `M${d}`} />)}
            </svg>
          </span>
        </a>
      );
    })}
  </div>

  <div class="mt-auto flex flex-col items-center gap-1">
    <a href={CRIADOR} class="app-dock-btn no-underline" aria-label="Criador de fichas" title="Criador de fichas">
      <span class="app-icon-card">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 3.5a2.1 2.1 0 0 1 3 3L8 17.5l-4 1 1-4Z" />
        </svg>
      </span>
    </a>
    <ThemeToggle />
  </div>
</nav>
