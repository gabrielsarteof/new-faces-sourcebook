---
import ThemeToggle from './ThemeToggle.astro';

/**
 * Dock de ícones, 72px.
 *
 * É o frame do criador: SystemSidebar variante desktop, w-18 navbar-bg
 * sidebar-boundary, com o logo numa faixa de 56px no topo e os itens em card de
 * ícone abaixo. O criador não põe texto aqui, e o site também não.
 */
interface Props { rotaAtual?: string }
const { rotaAtual = '' } = Astro.props;

const itens = [
  { rotulo: 'Início', href: '/', d: 'M3 10.5 12 3l9 7.5M5.5 9.5V20h13V9.5' },
  { rotulo: 'Regras de núcleo', href: '/core', d: 'M4 5.5A1.5 1.5 0 0 1 5.5 4H19v16H5.5A1.5 1.5 0 0 1 4 18.5ZM8 4v16' },
  { rotulo: 'Naruto', href: '/naruto', d: 'M12 3a9 9 0 1 0 9 9 6 6 0 0 1-9-9Z' },
  { rotulo: 'Jujutsu', href: '/jujutsu', d: 'M5 5l14 14M19 5 5 19' },
];
const CRIADOR = 'https://new-faces-character-creator.vercel.app';
---
<nav
  class="fixed inset-y-0 left-0 z-[80] hidden w-18 flex-col navbar-bg sidebar-boundary px-1.5 pt-14 pb-3 lg:flex"
  aria-label="Navegação principal"
>
  <div class="absolute inset-x-0 top-0 flex h-14 items-center justify-center">
    <a href="/" class="flex h-9 w-9 items-center justify-center" aria-label="Início">
      <img src="/logo-icon.png" alt="" width="24" height="24" class="h-6 w-6 select-none object-contain" draggable="false" />
    </a>
  </div>

  <div class="flex shrink-0 flex-col">
    {itens.map(i => {
      const ativo = i.href === '/' ? rotaAtual === '/' : rotaAtual.startsWith(i.href);
      return (
        <a href={i.href} class="app-dock-btn no-underline" aria-current={ativo ? 'page' : undefined} title={i.rotulo}>
          <span class="app-icon-card">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={ativo ? 2.5 : 1.5} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={i.d} />
            </svg>
          </span>
        </a>
      );
    })}
  </div>

  <div class="mt-auto flex flex-col items-center gap-1">
    <a href={CRIADOR} class="app-dock-btn no-underline" title="Criador de fichas">
      <span class="app-icon-card">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 3.5a2.1 2.1 0 0 1 3 3L8 17.5l-4 1 1-4Z" />
        </svg>
      </span>
    </a>
    <ThemeToggle />
  </div>
</nav>
