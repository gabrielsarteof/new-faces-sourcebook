---
import { arvoreDeNavegacao, mundoDaRota } from '../application/navegacao';
import { marcarRotaAtual } from '../domain/navegacao';

/**
 * Painel de navegação, 280px.
 *
 * Contextual à rota, como o Supabase Docs: medido ao vivo, a home dele
 * (supabase.com/docs) não tem nenhuma árvore lateral, e qualquer página de guia tem
 * uma sempre presente. Não existe estado de "abrir/fechar" no desktop — a página que
 * a rota carrega já vem com painel ou sem, e a decisão de reservar o espaço para ele
 * mora em `DocsLayout.astro` (`abrirNoDesktop`). O JavaScript deste arquivo só
 * governa a gaveta do celular, onde o dock fica oculto e o painel é a navegação.
 *
 * Dentro de um mundo, mostra os documentos dele — derivados da coleção, com o eixo
 * de perícias subdividido por categoria de custo, lida do Registro de Regentes do
 * Índice de Perícias. Fora de um mundo (Início, Começar), mostra a lista de seções
 * que o dock oferece, porque no celular o dock nem aparece: sem isto, quem entra
 * pelo celular na home não teria como alcançar Naruto ou Jujutsu.
 *
 * Modelado em QuickSwitchPanel.tsx: rótulo de grupo em 10px uppercase, item em
 * text-sm font-medium de caixa normal.
 */
interface Props {
  rotaAtual?: string;
  /**
   * Se o painel abre sozinho no desktop.
   *
   * Contextual à rota, como o Supabase: home e Começar não pertencem a mundo
   * nenhum, então não têm o que preencher aqui — a página delas ocupa a largura
   * inteira, igual a `supabase.com/docs`, medido sem sidebar nenhuma. Dentro de um
   * mundo o painel abre sozinho, sem precisar de clique.
   */
  abrirNoDesktop?: boolean;
}
const { rotaAtual = '/', abrirNoDesktop = true } = Astro.props;

const arvore = marcarRotaAtual(await arvoreDeNavegacao(), rotaAtual);
const mundo = mundoDaRota(rotaAtual, arvore);
const CRIADOR = 'https://new-faces-character-creator.vercel.app';
---
<aside
  id="docs-nav"
  class:list={[
    'sidebar-scroll fixed inset-y-0 left-0 z-[70] flex w-[280px] -translate-x-full flex-col overflow-y-auto navbar-bg sidebar-boundary pb-6 transition-transform duration-300 ease-in-out',
    abrirNoDesktop && 'lg:translate-x-[72px]',
  ]}
  aria-label="Documentos"
>
  <header class="mb-3 flex shrink-0 items-center justify-between px-4 py-3">
    <a href="/" class="flex h-7 items-center gap-2 no-underline sm:h-8">
      <img src="/logo-wordmark.png" alt="New Faces" class="h-full w-auto select-none object-contain" draggable="false" />
      <span class="app-section-label !p-0">docs</span>
    </a>
    <button
      id="nav-close"
      type="button"
      class="app-icon-card text-mono-sub hover:text-mono-text cursor-pointer lg:hidden"
      aria-label="Fechar navegação"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </header>

  <div class="shrink-0 px-3 pb-3">
    <button
      type="button"
      class="flex w-full items-center gap-2 rounded-xl bg-mono-card px-3 py-2 text-sm text-mono-sub transition-colors hover:bg-mono-card-hover"
      aria-label="Buscar na documentação"
      disabled
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="shrink-0">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
      </svg>
      <span class="flex-1 text-left">Buscar</span>
      <kbd class="rounded border border-mono-border px-1.5 py-0.5 font-sans text-[10px]">Ctrl K</kbd>
    </button>
  </div>

  {mundo ? (
    <>
      <div class="shrink-0 px-4 pb-1">
        <a href={mundo.base} class="text-sm font-bold text-mono-text no-underline">{mundo.rotulo}</a>
        <span class="ml-1.5 text-xs text-mono-muted">{mundo.total} documentos</span>
      </div>

      <nav class="flex flex-col px-3">
        {mundo.grupos.map(g => (
          <details class="nav-grupo" open={g.contemRotaAtual}>
            <summary class="nav-grupo-cabecalho app-section-label">
              <svg class="nav-chevron shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
              </svg>
              <span class="flex-1">{g.titulo}</span>
              <span class="nav-contagem">{g.itens.length}</span>
            </summary>

            <div class="nav-grupo-corpo">
              <div class="nav-grupo-conteudo">
                {g.rotaDoIndice && (
                  <a
                    href={g.rotaDoIndice}
                    aria-current={g.rotaDoIndice === rotaAtual ? 'page' : undefined}
                    class="app-nav-item nav-item-indice no-underline"
                  >
                    <span class="flex-1 truncate">Visão geral</span>
                  </a>
                )}

                {g.subgrupos
                  ? g.subgrupos.map(sub => (
                      <details class="nav-subgrupo" open={sub.contemRotaAtual}>
                        <summary class="nav-subgrupo-cabecalho app-section-label">
                          <svg class="nav-chevron shrink-0" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m9 18 6-6-6-6" />
                          </svg>
                          <span class="flex-1">{sub.titulo}</span>
                          <span class="nav-contagem">{sub.itens.length}</span>
                        </summary>
                        <div class="nav-grupo-corpo">
                          <div class="nav-grupo-conteudo">
                            {sub.itens.map(i => (
                              <a href={i.rota} aria-current={i.rota === rotaAtual ? 'page' : undefined} class="app-nav-item no-underline">
                                <span class="flex-1 truncate">{i.titulo}</span>
                                {i.emprestado && (
                                  <span class="shrink-0 text-[9px] uppercase tracking-widest text-mono-muted" title="Perícia sem cenário, jogável em qualquer mesa">
                                    comum
                                  </span>
                                )}
                              </a>
                            ))}
                          </div>
                        </div>
                      </details>
                    ))
                  : g.itens
                      .filter(i => i.rota !== g.rotaDoIndice)
                      .map(i => (
                        <a href={i.rota} aria-current={i.rota === rotaAtual ? 'page' : undefined} class="app-nav-item no-underline">
                          <span class="flex-1 truncate">{i.titulo}</span>
                        </a>
                      ))}
              </div>
            </div>
          </details>
        ))}
      </nav>
    </>
  ) : (
    <>
      {/*
        Fora de um mundo: mesma lista que o dock oferece, porque no celular o dock
        não existe. É o único jeito de alcançar Naruto ou Jujutsu a partir da home
        num aparelho de tela estreita.
      */}
      <nav class="flex flex-col px-3">
        <div class="flex flex-col">
          <p class="app-section-label">Seções</p>
          <a href="/" aria-current={rotaAtual === '/' ? 'page' : undefined} class="app-nav-item no-underline">
            <span class="flex-1 truncate">Início</span>
          </a>
          <a href="/comecar" aria-current={rotaAtual === '/comecar' ? 'page' : undefined} class="app-nav-item no-underline">
            <span class="flex-1 truncate">Começar</span>
          </a>
        </div>
        <div class="flex flex-col">
          <p class="app-section-label">Mundos</p>
          {arvore.map(m => (
            <a href={m.base} class="app-nav-item no-underline">
              <span class="flex-1 truncate">{m.rotulo}</span>
              <span class="shrink-0 text-xs text-mono-muted">{m.total}</span>
            </a>
          ))}
        </div>
        <div class="flex flex-col">
          <p class="app-section-label">Fora daqui</p>
          <a href={CRIADOR} class="app-nav-item no-underline">
            <span class="flex-1 truncate">Criador de fichas</span>
          </a>
        </div>
      </nav>
    </>
  )}
</aside>

<div id="nav-backdrop" class="fixed inset-0 z-[60] hidden bg-black/50 lg:hidden" aria-hidden="true"></div>

<script>
  const painel = document.getElementById('docs-nav');
  const backdrop = document.getElementById('nav-backdrop');
  const abrir = document.getElementById('nav-toggle');
  const fechar = document.getElementById('nav-close');

  const setAberto = (aberto: boolean) => {
    painel?.classList.toggle('-translate-x-full', !aberto);
    backdrop?.classList.toggle('hidden', !aberto);
    abrir?.setAttribute('aria-expanded', String(aberto));
    document.body.style.overflow = aberto ? 'hidden' : '';
    if (aberto) painel?.querySelector<HTMLAnchorElement>('nav a')?.focus();
  };

  abrir?.addEventListener('click', () => setAberto(true));
  fechar?.addEventListener('click', () => setAberto(false));
  backdrop?.addEventListener('click', () => setAberto(false));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !backdrop?.classList.contains('hidden')) setAberto(false);
  });

  // Rola até o item corrente, que pode estar fora da vista numa árvore longa.
  painel?.querySelector('[aria-current="page"]')?.scrollIntoView({ block: 'center' });
</script>
