---
/**
 * Painel de navegação, 280px.
 *
 * Modelado em QuickSwitchPanel.tsx, que é o painel de texto que o criador já
 * encosta no dock: w-[280px] navbar-bg sidebar-boundary, cabeçalho com o
 * wordmark, campo de busca, rótulo de grupo em 10px uppercase e item em
 * text-sm font-medium de caixa normal.
 *
 * Na fase 2 a árvore passa a sair do manifesto curado, que contém só `id`.
 */
interface Item { rotulo: string; href: string }
interface Grupo { titulo: string; itens: Item[] }
interface Props { rotaAtual?: string }

const { rotaAtual = '' } = Astro.props;

const grupos: Grupo[] = [
  {
    titulo: 'Começar',
    itens: [
      { rotulo: 'Visão geral', href: '/' },
      { rotulo: 'Criar personagem', href: '/naruto/character-creation' },
      { rotulo: 'Cálculos rápidos', href: '/naruto/quick-calculations' },
    ],
  },
  {
    titulo: 'Núcleo',
    itens: [
      { rotulo: 'Economia de XP', href: '/core/xp-economy' },
      { rotulo: 'Núcleo de Perícias', href: '/core/skills-core' },
      { rotulo: 'Núcleo de Combate', href: '/core/combat-core' },
      { rotulo: 'Efeitos de status', href: '/core/status-effects' },
    ],
  },
  {
    titulo: 'Naruto · Perícias',
    itens: [
      { rotulo: 'Índice de Perícias', href: '/naruto/skill' },
      { rotulo: 'Katon', href: '/naruto/skill/katon' },
      { rotulo: 'Raiton', href: '/naruto/skill/raiton' },
      { rotulo: 'Controle de Chakra', href: '/naruto/skill/chakra-control' },
    ],
  },
  {
    titulo: 'Naruto · Clãs',
    itens: [
      { rotulo: 'Clãs', href: '/naruto/clan' },
      { rotulo: 'Uchiha', href: '/naruto/clan/uchiha' },
      { rotulo: 'Senju', href: '/naruto/clan/senju' },
    ],
  },
];
---
<aside
  id="docs-nav"
  class="sidebar-scroll fixed inset-y-0 left-0 z-[70] flex w-[280px] -translate-x-full flex-col overflow-y-auto navbar-bg sidebar-boundary pb-6 transition-transform duration-300 ease-in-out lg:translate-x-[72px]"
  aria-label="Navegação da documentação"
>
  <header class="mb-3 flex shrink-0 items-center justify-between px-4 py-3">
    <a href="/" class="flex h-7 items-center gap-2 no-underline sm:h-8">
      <img src="/logo-wordmark.png" alt="New Faces" class="h-full w-auto select-none object-contain" draggable="false" />
      <span class="app-section-label !p-0 !tracking-widest">docs</span>
    </a>
    <button
      id="nav-close"
      type="button"
      class="app-icon-card text-mono-sub hover:text-mono-text cursor-pointer lg:hidden"
      aria-label="Fechar navegação"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </header>

  <div class="shrink-0 px-3 pb-3">
    <button
      type="button"
      class="relative flex w-full items-center gap-2 rounded-xl bg-mono-card px-3 py-2 text-sm text-mono-sub transition-colors hover:bg-mono-card-hover"
      aria-label="Buscar na documentação"
      disabled
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="shrink-0">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
      </svg>
      <span class="flex-1 text-left">Buscar</span>
      <kbd class="rounded border border-mono-border px-1.5 py-0.5 text-[10px] font-sans">Ctrl K</kbd>
    </button>
  </div>

  <nav class="flex flex-col px-3">
    {grupos.map(g => (
      <div class="flex flex-col">
        <p class="app-section-label">{g.titulo}</p>
        {g.itens.map(i => (
          <a
            href={i.href}
            aria-current={i.href === rotaAtual ? 'page' : undefined}
            class="app-nav-item no-underline"
          >{i.rotulo}</a>
        ))}
      </div>
    ))}
  </nav>
</aside>

<div id="nav-backdrop" class="fixed inset-0 z-[60] hidden bg-black/50 lg:hidden" aria-hidden="true"></div>

<script>
  const painel = document.getElementById('docs-nav');
  const backdrop = document.getElementById('nav-backdrop');
  const abrir = document.getElementById('nav-toggle');
  const fechar = document.getElementById('nav-close');

  const setAberto = (aberto: boolean) => {
    painel?.classList.toggle('-translate-x-full', !aberto);
    backdrop?.classList.toggle('hidden', !aberto);
    abrir?.setAttribute('aria-expanded', String(aberto));
    document.body.style.overflow = aberto ? 'hidden' : '';
    if (aberto) painel?.querySelector<HTMLAnchorElement>('nav a')?.focus();
  };

  abrir?.addEventListener('click', () => setAberto(true));
  fechar?.addEventListener('click', () => setAberto(false));
  backdrop?.addEventListener('click', () => setAberto(false));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !backdrop?.classList.contains('hidden')) setAberto(false);
  });
</script>
