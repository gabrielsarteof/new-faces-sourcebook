---
/**
 * Navegação lateral.
 *
 * Segue a variante mobile de SystemSidebar.tsx do criador, que é o idioma dele
 * para navegação em texto: w-72, navbar-bg, linhas com px-3 min-h-11 rounded-xl,
 * rótulo em uppercase tracking-widest, ativa em bg-mono-card. No desktop ela fica
 * fixa em coluna; no celular vira gaveta, como lá.
 *
 * Na fase 2 a árvore passa a sair do manifesto curado, que contém só `id`.
 */
interface Item { rotulo: string; href: string }
interface Grupo { titulo: string; itens: Item[] }
interface Props { rotaAtual?: string }

const { rotaAtual = '' } = Astro.props;

const grupos: Grupo[] = [
  {
    titulo: 'Começar',
    itens: [
      { rotulo: 'Visão geral', href: '/' },
      { rotulo: 'Criar personagem', href: '/naruto/character-creation' },
      { rotulo: 'Cálculos rápidos', href: '/naruto/quick-calculations' },
    ],
  },
  {
    titulo: 'Núcleo',
    itens: [
      { rotulo: 'Economia de XP', href: '/core/xp-economy' },
      { rotulo: 'Núcleo de Perícias', href: '/core/skills-core' },
      { rotulo: 'Núcleo de Combate', href: '/core/combat-core' },
      { rotulo: 'Efeitos de status', href: '/core/status-effects' },
    ],
  },
  {
    titulo: 'Naruto · Perícias',
    itens: [
      { rotulo: 'Índice de Perícias', href: '/naruto/skill' },
      { rotulo: 'Katon', href: '/naruto/skill/katon' },
      { rotulo: 'Raiton', href: '/naruto/skill/raiton' },
      { rotulo: 'Controle de Chakra', href: '/naruto/skill/chakra-control' },
    ],
  },
  {
    titulo: 'Naruto · Clãs',
    itens: [
      { rotulo: 'Clãs', href: '/naruto/clan' },
      { rotulo: 'Uchiha', href: '/naruto/clan/uchiha' },
      { rotulo: 'Senju', href: '/naruto/clan/senju' },
    ],
  },
];
---
<aside
  id="docs-sidebar"
  class="sidebar-scroll fixed inset-y-0 left-0 z-50 w-72 -translate-x-full overflow-y-auto navbar-bg sidebar-boundary px-2 pt-6 pb-10 transition-transform duration-200 lg:sticky lg:top-14 lg:z-0 lg:h-[calc(100vh-3.5rem)] lg:translate-x-0 lg:shrink-0 lg:pt-6"
  aria-label="Navegação da documentação"
>
  <div class="mb-4 flex items-center justify-between px-3 lg:hidden">
    <span class="app-nav-label text-mono-text">Navegação</span>
    <button
      id="nav-close"
      type="button"
      class="app-icon-card text-mono-sub hover:text-mono-text cursor-pointer"
      aria-label="Fechar navegação"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="flex flex-col gap-5">
    {grupos.map(g => (
      <div class="flex flex-col gap-0.5">
        <h2 class="app-nav-label mb-1 px-3 text-mono-muted">{g.titulo}</h2>
        {g.itens.map(i => (
          <a
            href={i.href}
            aria-current={i.href === rotaAtual ? 'page' : undefined}
            class="app-nav-row app-nav-label no-underline"
          >{i.rotulo}</a>
        ))}
      </div>
    ))}
  </nav>
</aside>

<div
  id="nav-backdrop"
  class="fixed inset-0 z-40 hidden bg-black/40 lg:hidden"
  aria-hidden="true"
></div>

<script>
  const sidebar = document.getElementById('docs-sidebar');
  const backdrop = document.getElementById('nav-backdrop');
  const abrir = document.getElementById('nav-toggle');
  const fechar = document.getElementById('nav-close');

  const setAberto = (aberto: boolean) => {
    sidebar?.classList.toggle('-translate-x-full', !aberto);
    backdrop?.classList.toggle('hidden', !aberto);
    abrir?.setAttribute('aria-expanded', String(aberto));
    document.body.style.overflow = aberto ? 'hidden' : '';
    if (aberto) sidebar?.querySelector<HTMLAnchorElement>('nav a')?.focus();
  };

  abrir?.addEventListener('click', () => setAberto(true));
  fechar?.addEventListener('click', () => setAberto(false));
  backdrop?.addEventListener('click', () => setAberto(false));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !backdrop?.classList.contains('hidden')) setAberto(false);
  });
</script>
