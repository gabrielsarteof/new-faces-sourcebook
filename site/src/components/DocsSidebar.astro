---
/**
 * Navegação lateral.
 *
 * Na fase 2 a árvore passa a sair do manifesto curado, que contém só `id`. Aqui
 * ela é fixture, para julgar medidas e estados antes de existir conteúdo.
 */
interface Item { rotulo: string; href: string }
interface Grupo { titulo: string; itens: Item[] }

const grupos: Grupo[] = [
  {
    titulo: 'Começar',
    itens: [
      { rotulo: 'O que é o New Faces', href: '/' },
      { rotulo: 'Criar personagem', href: '/naruto/character-creation' },
      { rotulo: 'Cálculos rápidos', href: '/naruto/quick-calculations' },
    ],
  },
  {
    titulo: 'Regras de núcleo',
    itens: [
      { rotulo: 'Economia de XP', href: '/core/xp-economy' },
      { rotulo: 'Núcleo de Perícias', href: '/core/skills-core' },
      { rotulo: 'Núcleo de Combate', href: '/core/combat-core' },
      { rotulo: 'Efeitos de status', href: '/core/status-effects' },
    ],
  },
  {
    titulo: 'Naruto · Perícias',
    itens: [
      { rotulo: 'Índice de Perícias', href: '/naruto/skill' },
      { rotulo: 'Katon', href: '/naruto/skill/katon' },
      { rotulo: 'Raiton', href: '/naruto/skill/raiton' },
      { rotulo: 'Controle de Chakra', href: '/naruto/skill/chakra-control' },
    ],
  },
  {
    titulo: 'Naruto · Clãs',
    itens: [
      { rotulo: 'Clãs', href: '/naruto/clan' },
      { rotulo: 'Uchiha', href: '/naruto/clan/uchiha' },
      { rotulo: 'Senju', href: '/naruto/clan/senju' },
    ],
  },
];

interface Props { rotaAtual?: string }
const { rotaAtual = '' } = Astro.props;
---
<aside
  id="docs-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-[264px] -translate-x-full overflow-y-auto border-r border-[var(--color-sidebar-border)] bg-[var(--color-mono-bg)] pb-10 transition-transform duration-200 lg:sticky lg:top-14 lg:z-0 lg:h-[calc(100vh-3.5rem)] lg:translate-x-0 lg:bg-transparent"
  aria-label="Navegação da documentação"
>
  <div class="flex h-14 items-center justify-between px-4 lg:hidden">
    <span class="text-sm font-bold text-[var(--color-mono-text)]">Navegação</span>
    <button
      id="nav-close"
      type="button"
      class="grid h-8 w-8 place-items-center rounded-md border border-[var(--color-mono-border)] text-[var(--color-mono-sub)]"
      aria-label="Fechar navegação"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="px-3 pt-2 lg:pt-6">
    {grupos.map(g => (
      <div class="mb-6">
        <h2 class="mb-1.5 px-2.5 text-[11px] font-bold uppercase tracking-widest text-[var(--color-mono-muted)]">
          {g.titulo}
        </h2>
        <ul class="space-y-px">
          {g.itens.map(i => (
            <li>
              <a
                href={i.href}
                aria-current={i.href === rotaAtual ? 'page' : undefined}
                class="block rounded-md px-2.5 py-1.5 text-[13px] leading-snug text-[var(--color-mono-sub)] no-underline transition-colors hover:bg-[var(--color-mono-card-hover)] hover:text-[var(--color-mono-text)] aria-[current=page]:bg-[var(--color-mono-card)] aria-[current=page]:font-semibold aria-[current=page]:text-[var(--color-mono-text)]"
              >{i.rotulo}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<div
  id="nav-backdrop"
  class="fixed inset-0 z-40 hidden bg-black/40 backdrop-blur-[1px] lg:hidden"
  aria-hidden="true"
></div>

<script>
  const sidebar = document.getElementById('docs-sidebar');
  const backdrop = document.getElementById('nav-backdrop');
  const abrir = document.getElementById('nav-toggle');
  const fechar = document.getElementById('nav-close');

  const setAberto = (aberto: boolean) => {
    sidebar?.classList.toggle('-translate-x-full', !aberto);
    backdrop?.classList.toggle('hidden', !aberto);
    abrir?.setAttribute('aria-expanded', String(aberto));
    document.body.style.overflow = aberto ? 'hidden' : '';
    if (aberto) sidebar?.querySelector<HTMLAnchorElement>('nav a')?.focus();
  };

  abrir?.addEventListener('click', () => setAberto(true));
  fechar?.addEventListener('click', () => setAberto(false));
  backdrop?.addEventListener('click', () => setAberto(false));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !backdrop?.classList.contains('hidden')) setAberto(false);
  });
</script>
