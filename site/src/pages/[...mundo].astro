---
import DocsLayout from '../layouts/DocsLayout.astro';
import { MUNDOS } from '../data/navegacao';

/**
 * Página de índice de mundo, provisória.
 *
 * Existe para que o dock tenha destino e a troca de mundo seja verificável antes
 * de o pipeline existir. Na fase 2 estas rotas passam a renderizar o `overview.md`
 * de cada mundo, resolvido pelo `id`, e este arquivo some.
 */
export function getStaticPaths() {
  return MUNDOS.filter(m => m.base !== '/').map(m => ({
    params: { mundo: m.base.slice(1) },
    props: { mundo: m },
  }));
}

const { mundo } = Astro.props;
const total = mundo.grupos.reduce((n, g) => n + g.itens.length, 0);
---
<DocsLayout
  titulo={mundo.rotulo}
  descricao={`Documentos de ${mundo.rotulo} no sourcebook do New Faces.`}
  trilha={[{ rotulo: 'Início', href: '/' }, { rotulo: mundo.rotulo }]}
>
  <h1>{mundo.rotulo}</h1>

  <p>
    Índice provisório. O painel à esquerda lista os {total} documentos que esta fase
    já enumera para este mundo; o dock troca de mundo sem trocar de página inteira.
  </p>

  <p>
    Na fase 2 esta rota passa a renderizar o documento de visão geral do próprio
    corpus, resolvido pelo <code>id</code>, e a lista deixa de ser escrita à mão.
  </p>

  {mundo.grupos.map(g => (
    <>
      <h2 id={g.titulo.toLowerCase().replace(/[^a-z]+/g, '-')}>{g.titulo}</h2>
      <ul>
        {g.itens.map(i => <li><a href={i.href}>{i.rotulo}</a></li>)}
      </ul>
    </>
  ))}
</DocsLayout>
