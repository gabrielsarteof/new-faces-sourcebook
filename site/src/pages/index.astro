---
import DocsLayout from '../layouts/DocsLayout.astro';
import { documentosPublicos, agruparPorEixo } from '../application/documentos';
import { rotuloDoMundo, rotuloPluralDoEixo, ordemDoEixo } from '../data/rotulos';

/**
 * Home.
 *
 * Combina dois eixos, como o Supabase Docs faz: primeiro os mundos disponíveis, com
 * contagem real saída da coleção, depois as tarefas com que o jogador chega. A
 * contagem não é escrita à mão de propósito — documento novo muda o número sozinho,
 * e um número que mente é pior que nenhum.
 *
 * A prosa desta página é copy de interface do site, e não regra: nenhuma linha aqui
 * afirma mecânica. Onde há afirmação de regra, ela mora no corpus.
 */
const publicos = await documentosPublicos();

const ORDEM_MUNDOS = ['core', 'common', 'naruto', 'jujutsu'];
const porMundo = new Map<string, typeof publicos>();
for (const p of publicos) {
  if (!porMundo.has(p.mundo)) porMundo.set(p.mundo, []);
  porMundo.get(p.mundo)!.push(p);
}
const mundos = [...porMundo.entries()].sort(
  (a, b) => ORDEM_MUNDOS.indexOf(a[0]) - ORDEM_MUNDOS.indexOf(b[0]),
);

const descricaoDoMundo: Record<string, string> = {
  core: 'As regras que valem em qualquer cenário: economia de XP, perícias, combate e efeitos de status.',
  common: 'Perícias que não leem nenhum fato de cenário e valem em qualquer mesa.',
  naruto: 'O cenário principal: perícias, clãs, linhagens, compêndios de técnicas e sistemas.',
  jujutsu: 'Cenário em cobertura fina, com clãs, linhagens e técnicas ainda em preenchimento.',
};

/** Eixo mais volumoso de cada mundo, como atalho de leitura no card. */
function destaques(membros: typeof publicos) {
  return [...agruparPorEixo(membros).entries()]
    .filter(([eixo]) => eixo)
    .sort((a, b) => ordemDoEixo(a[0]) - ordemDoEixo(b[0]))
    .slice(0, 4);
}
---
<DocsLayout
  titulo="New Faces docs"
  descricao="Site público de leitura do sourcebook do New Faces."
  trilha={[{ rotulo: 'Início' }]}
  comPainel={false}
>
  <h1>New Faces docs</h1>

  <p>
    O manual do New Faces, publicado para leitura. O corpus é a fonte de verdade e
    este site consome: nada de regra nasce aqui, e divergência entre os dois significa
    que o site está atrasado.
  </p>

  <p>
    São <strong>{publicos.length} documentos</strong> publicados. Toda página é gerada
    do Markdown do corpus, então documento novo aparece sem que ninguém escreva código.
    Primeira vez aqui? <a href="/comecar">Veja como começar</a>, com o que os selos de
    cor significam e por onde entrar.
  </p>

  <h2 id="mundos">Mundos</h2>

  <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
    {mundos.map(([mundo, membros]) => (
      <a
        href={`/${mundo}`}
        class="flex flex-col gap-2 rounded-xl border border-mono-border bg-mono-card p-4 no-underline transition-colors hover:bg-mono-card-hover"
      >
        <div class="flex items-baseline justify-between gap-2">
          <span class="text-base font-bold text-mono-text">{rotuloDoMundo(mundo)}</span>
          <span class="text-xs text-mono-muted">{membros.length} documentos</span>
        </div>
        <p class="text-sm leading-snug text-mono-sub">{descricaoDoMundo[mundo]}</p>
        <div class="mt-1 flex flex-wrap gap-1.5">
          {destaques(membros).map(([eixo, docs]) => (
            <span class="rounded-md border border-mono-border px-1.5 py-0.5 text-[11px] text-mono-muted">
              {rotuloPluralDoEixo(eixo)} · {docs.length}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>

</DocsLayout>
